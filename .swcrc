{
  "$schema": "https://json.schemastore.org/swcrc",
  "isModule": true,
  "module": {
    "type": "commonjs",
    "strict": true,
    "noInterop": false
  },
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": false,
      "tsx": false
    },
    "transform": {
      "decoratorMetadata": true,
      "legacyDecorator": true
    },
    "target": "es2022"
  }
}
